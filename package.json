{
  "name": "@johnhenry/http-converter",
  "version": "0.0.1",
  "description": "Modern HTTP format converter - Transform between HTTP strings, HAR, cURL commands, and Fetch API",
  "type": "module",
  "main": "index.mjs",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "types": "./types.d.ts"
    },
    "./string": {
      "import": "./string/index.mjs",
      "types": "./string/index.d.mts"
    },
    "./har": {
      "import": "./har/index.mjs",
      "types": "./har/index.d.mts"
    },
    "./curl": {
      "import": "./curl/index.mjs",
      "types": "./curl/index.d.mts"
    },
    "./fetch": {
      "import": "./fetch/index.mjs",
      "types": "./fetch/index.d.mts"
    },
    "./core/utils": {
      "import": "./core/utils.mjs",
      "types": "./core/utils.d.mts"
    },
    "./body": {
      "import": "./body/index.mjs",
      "types": "./body/index.d.mts"
    },
    "./random": {
      "import": "./random/index.mjs",
      "types": "./random/index.d.mts"
    }
  },
  "files": [
    "index.mjs",
    "types.d.ts",
    "core/",
    "string/",
    "har/",
    "curl/",
    "fetch/",
    "body/",
    "random/"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "test:watch": "node --test --watch test/**/*.test.mjs",
    "test:types": "tsc --noEmit -p test/types/tsconfig.json",
    "lint": "eslint .",
    "examples": "for f in examples/[0-9]*.mjs; do echo \"=== $f\"; node \"$f\" || exit 1; done",
    "example:01": "node examples/01-url-formats.mjs",
    "example:02": "node examples/02-advanced-usage.mjs"
  },
  "keywords": [
    "http",
    "har",
    "curl",
    "fetch",
    "converter",
    "parser",
    "http-parser",
    "http-string",
    "curl-to-fetch",
    "har-converter",
    "browser"
  ],
  "author": "John Henry",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/http-converter.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/http-converter/issues"
  },
  "homepage": "https://opensource.johnhenry.me/http-converter/"
}